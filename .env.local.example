# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Dev mode ---
# Set to true for local preview with no AWS account: uses an in-memory
# order/rider store instead of DynamoDB. A single rider is seeded automatically
# — employeeId "HLBR-STORE-DEL-1", password "pass@1234" — plus sample orders whose
# delivery passcodes are 4821 and 1357.
# Keep both lines set to the same value. Never set these in production.
DEV_MODE=false
NEXT_PUBLIC_DEV_MODE=false

# --- AWS / DynamoDB ---
# Only needed locally — on Amplify this is auto-provided by the Lambda runtime
# and can't be set as a custom env var there (AWS_ reserved prefix).
AWS_REGION=ap-south-1

DYNAMODB_ORDERS_TABLE=hlbr_store_orders
DYNAMODB_RIDERS_TABLE=hlbr_store_riders

# --- Auth session ---
# Long random string used to sign the rider session JWT. Generate a NEW one for this app:
#   openssl rand -base64 48
SESSION_SECRET=
